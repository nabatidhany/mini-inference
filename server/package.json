{
  "name": "inference-router-server",
  "version": "1.0.0",
  "private": true,
  "description": "Mini inference gateway: per-tenant auth, token quota, model routing with fallback, metering, and a RAG support assistant",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "slice:dataset": "tsx src/scripts/slice-dataset.ts",
    "eval": "tsx src/scripts/eval.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "express": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
