# Gateway secrets — copy to .env and fill in.
# (The demo API keys in lib/seed.ts are seeded public demo data, not secrets.)

# Required for the real backend (create a free key at console.groq.com)
GROQ_API_KEY=

# Admin key for /admin/* (chaos switches, router config, internal metering).
# MUST be changed for any real deployment.
ADMIN_KEY=dev-admin-key

# Optional overrides
# PORT=8080
# DB_PATH=data/app.db
# GROQ_MODEL=openai/gpt-oss-20b
# CORS_ORIGIN=https://your-console.vercel.app
# TTFB_TIMEOUT_MS=12000
# TOTAL_TIMEOUT_MS=30000
# SHORT_CIRCUIT_THRESHOLD=0.75
# COVERAGE_FLOOR=0.4
# CONFIDENCE_THRESHOLD=0.35
